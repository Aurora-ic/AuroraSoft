# .env del PILOTO (va en %USERPROFILE%\aurorasoft-piloto\backend\.env).
# Este archivo de ejemplo NO tiene secretos; el .env real nunca se sube a git.
# Ver docs/piloto.md. Después de completarlo: scripts\piloto\piloto.ps1 verificar

# --- Modo producción (cookies Secure, sin /docs ni /openapi.json, HSTS) ---
ENTORNO=production

# --- Base NUEVA del piloto en Neon (NO la del desarrollo) ---
# En Neon: tu proyecto -> Databases -> New database "aurorasoft_piloto",
# y copia su connection string (la de "Pooled connection" sirve).
DATABASE_URL=

# Genera una propia:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Dominio público (el del túnel de Cloudflare) ---
FRONTEND_URL=https://TU-DOMINIO
PUBLIC_BACKEND_URL=https://TU-DOMINIO
CORS_ALLOWED_ORIGINS=https://TU-DOMINIO

# cloudflared corre en esta misma PC: la IP real del alumno llega en
# X-Forwarded-For desde 127.0.0.1. Sin esto, todos los alumnos de todos los
# colegios comparten una IP y el límite por IP los bloquea juntos.
PROXIES_CONFIABLES=127.0.0.1,::1

# Frontend y API en el mismo dominio: basta lax.
SESION_COOKIE_SAMESITE=lax

# --- Redis local (Memurai): bases 2/3/4, las 0/1 son del desarrollo ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
ALMACEN_SEGURIDAD_URL=redis://localhost:6379/4

# --- Archivos: el mismo bucket de R2, bajo el prefijo piloto/ ---
STORAGE_BACKEND=s3
STORAGE_PREFIJO=piloto/
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=aurorasoft-compartido
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Correo (Gmail con contraseña de aplicación) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USUARIO=
EMAIL_PASSWORD=
EMAIL_REMITENTE=AuroraSoft <TU-CORREO>

# --- Superadmin inicial del piloto (cámbiale la contraseña al entrar) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Opcional: errores en Sentry (plan gratis, sin tarjeta) ---
SENTRY_DSN=
